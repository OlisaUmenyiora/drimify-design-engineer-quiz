# Copy to `.env.local` and restart `npm run dev`.
# Never commit `.env.local` (this repo gitignores `*.local`).

# Pexels picker in the browser (VITE_). Also used for optional AI image enrichment on the dev server.
VITE_PEXELS_API_KEY=

# Server-only (used by Vite dev middleware `/api/generate-quiz`). Do NOT prefix with VITE_.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional: Pexels search for AI-generated question images (same key as above works).
# If unset, the dev server falls back to VITE_PEXELS_API_KEY for enrichment only.
PEXELS_API_KEY=
